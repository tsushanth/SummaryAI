{
  "name": "mm-live-stt",
  "version": "0.1.0",
  "private": true,
  "description": "MeetingMind live speech-to-text service: Recall audio websocket in, Soniox realtime, final segments out",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "replay": "tsx scripts/replay.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
