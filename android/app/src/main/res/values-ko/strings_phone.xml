    <!-- Phone calls -->
    <string name="service_description_call">다른 앱을 사용하는 동안에도 통화를 유지합니다</string>
    <string name="phone_notification_channel">전화 통화</string>
    <string name="phone_notification_title">통화 중</string>
    <string name="phone_minutes_left">이번 달 남은 무료 통화 시간(분): %1$d / %2$d</string>
    <string name="phone_service_used_up">이번 달 전화 통화 이용량이 모두 소진되었습니다. 다음 달에 다시 시도해 주세요.</string>
    <string name="phone_more_minutes_low">이번 달 무료 통화 시간이 얼마 남지 않았습니다.</string>
    <string name="phone_more_minutes_button">통화 시간이 더 필요해요</string>
    <string name="phone_more_minutes_thanks">감사합니다. 통화 시간을 더 제공하는 방안을 검토하겠습니다.</string>
    <string name="phone_your_number">내 번호</string>
    <string name="phone_verify_intro">전화를 걸면 본인의 번호가 표시됩니다. 번호를 등록하려면 저희가 해당 번호로 전화를 걸고, 휴대전화 키패드에 코드를 입력하시면 됩니다. 미국 및 캐나다 번호만 가능합니다.</string>
    <string name="phone_number_hint">국가 번호를 포함한 번호(예: +1 415 555 0100)</string>
    <string name="phone_verify_start">내 번호로 전화 받기</string>
    <string name="phone_verify_instruction">전화를 받고 휴대전화 키패드에 다음 코드를 입력하세요:</string>
    <string name="phone_verify_call_in_english">인증 전화는 영어로 진행됩니다.</string>
    <string name="phone_verify_waiting">코드 입력을 기다리는 중…</string>
    <string name="phone_verify_wrong_code">전화를 받지 않았거나 코드가 올바르게 입력되지 않았습니다. 다시 시도해 주세요.</string>
    <string name="phone_verify_expired">인증 시간이 초과되었습니다. 다시 시도해 주세요.</string>
    <string name="phone_remove_number_title">이 번호를 삭제할까요?</string>
    <string name="phone_remove_number_message">다시 인증하기 전까지는 전화를 걸 때 이 번호를 표시할 수 없습니다.</string>
    <string name="phone_remove">삭제</string>
    <string name="phone_error_country_code">번호는 +와 국가 번호로 시작해 주세요(예: +1).</string>
    <string name="phone_error_invalid_number">완전한 전화번호가 아닙니다.</string>
    <string name="phone_error_country_unsupported">통화는 미국 및 캐나다 번호만 지원합니다.</string>
    <string name="phone_error_number_not_allowed">수신자 부담 번호, 유료 정보 서비스 번호, 특수 요금 번호는 사용할 수 없습니다.</string>
    <string name="phone_error_too_soon">1분 후에 다시 전화를 요청해 주세요.</string>
    <string name="phone_error_verify_limit">인증 전화 요청이 너무 많습니다. 내일 다시 시도해 주세요.</string>
    <string name="phone_error_number_busy">이 번호로 인증 전화가 이미 진행 중입니다. 10분 후에 다시 시도해 주세요.</string>
    <string name="phone_error_unavailable">지금은 전화 통화를 이용할 수 없습니다. 나중에 다시 시도해 주세요.</string>
    <string name="phone_error_minutes_used">이번 달 무료 통화 시간을 모두 사용했습니다.</string>
    <string name="phone_error_number_in_use">이 번호는 이미 다른 계정에 등록되어 있습니다. 본인의 번호라면 고객 지원에 문의해 주세요.</string>
    <string name="phone_error_already_verified">이미 인증된 번호입니다.</string>
    <string name="phone_error_too_many_numbers">다른 번호를 추가하려면 먼저 인증된 번호를 삭제해 주세요.</string>
    <string name="phone_error_verify_call_failed">인증 전화를 걸 수 없습니다. 나중에 다시 시도해 주세요.</string>
    <string name="phone_error_call_in_progress">다른 통화가 아직 진행 중입니다.</string>
    <string name="phone_error_call_limit">짧은 시간에 통화가 너무 많습니다. 나중에 다시 시도해 주세요.</string>
    <string name="phone_error_destination_limit">오늘 이 번호로 너무 많이 전화했습니다. 내일 다시 시도해 주세요.</string>
    <string name="phone_error_update_app">전화를 걸려면 앱을 업데이트해 주세요.</string>
    <string name="phone_error_account">전화를 걸려면 이메일, Google 또는 Apple 계정으로 로그인해 주세요.</string>
    <string name="phone_error_remove_failed">번호를 삭제할 수 없습니다. 다시 시도해 주세요.</string>
    <string name="phone_consent_title">이 통화는 녹음됩니다</string>
    <string name="phone_consent_numbers">%1$s(으)로 전화를 걸며, 내 번호 %2$s이(가) 표시됩니다.</string>
    <string name="phone_consent_body">대화를 시작하기 전에 양쪽 모두에게 통화가 녹음된다는 음성 안내가 들립니다. 통화는 텍스트로 변환되고 요약되어 녹음 목록에 저장됩니다.</string>
    <string name="phone_consent_responsibility">이 통화를 녹음할 수 있도록 허용된 경우에만 계속하세요. 상대방이 반대하면 전화를 끊으세요.</string>
    <string name="phone_consent_accept">녹음하고 전화 걸기</string>
    <string name="phone_no_emergency">이 기능으로는 911 같은 긴급 서비스에 전화할 수 없습니다. 긴급 상황에서는 기기의 전화 앱을 사용하세요.</string>
