# Summary AI Backend - Environment Variables
# Copy this to .env and fill in your values

# Application
NODE_ENV=development
PORT=8080
API_VERSION=v1
LOG_LEVEL=info

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage buckets
STORAGE_BUCKET_AUDIO=recordings-audio
STORAGE_BUCKET_EXPORTS=exports

# File limits
MAX_AUDIO_FILE_SIZE_MB=200
MAX_RECORDING_DURATION_SECONDS=14400

# Upload URL expiry (1 hour)
UPLOAD_URL_EXPIRY_SECONDS=3600

# Deepgram (Speech-to-Text) - optional for initial setup
DEEPGRAM_API_KEY=your-deepgram-api-key

# Anthropic (LLM for Q&A and summarization)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048

# Q&A Configuration
QA_MAX_CONTEXT_TOKENS=50000
QA_MAX_RELEVANT_SEGMENTS=15

# GCP (optional, for Cloud Tasks)
GCP_PROJECT_ID=your-gcp-project
CLOUD_TASKS_QUEUE=processing-queue
