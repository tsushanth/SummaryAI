# Summary AI Backend - Environment Variables
# Copy this to .env and fill in your values

# Application
NODE_ENV=development
PORT=8080
API_VERSION=v1
LOG_LEVEL=info

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage buckets
STORAGE_BUCKET_AUDIO=recordings-audio
STORAGE_BUCKET_EXPORTS=exports

# File limits
MAX_AUDIO_FILE_SIZE_MB=200
MAX_RECORDING_DURATION_SECONDS=14400

# Upload URL expiry (1 hour)
UPLOAD_URL_EXPIRY_SECONDS=3600

# Deepgram (Speech-to-Text) - optional for initial setup
DEEPGRAM_API_KEY=your_deepgram_api_key

# Speech-to-text provider for the final transcript: deepgram (default) | soniox | shadow.
# shadow = Deepgram result is used, Soniox also runs in the background and a metrics-only row goes to stt_shadow_runs
# (migration 025). Both soniox and shadow send audio to Soniox: do not enable before the privacy page lists it.
# STT_PROVIDER=deepgram
# SONIOX_API_KEY=your-soniox-api-key
# STT_FALLBACK_TO_DEEPGRAM=true          # soniox mode: fall back to Deepgram on error/empty result (default true)
# STT_SHADOW_SAMPLE_RATE=1               # shadow mode: fraction of recordings sent to Soniox (0..1)
# STT_SHADOW_MAX_RUNS=                   # shadow mode: stop once stt_shadow_runs has this many rows
# STT_SHADOW_TIMEOUT_MS=900000
# SONIOX_MAX_CONCURRENT=3                # in-flight Soniox jobs per process (the key may be shared with other products)

# Anthropic (LLM for summaries and Q&A)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
SUMMARY_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2048

# Meeting bot join announcement (chat message posted by the bot when it joins). Default false (OFF).
# Only set true after the owner approves the wording in src/services/recallService.ts.
MEETING_BOT_ANNOUNCE=false

# Meeting bot monthly allowance per user (calendar month, UTC). Missing/0/invalid = default 120. Exempt ids are never capped.
BOT_FREE_MONTHLY_CAP_MINUTES=120
BOT_CAP_EXEMPT_USER_IDS=
# Longest single bot session (minutes) and kill switch for sending it to Recall ('off' disables).
BOT_MAX_SESSION_MINUTES=240
BOT_SESSION_LIMIT=on

# Q&A Configuration
QA_MAX_CONTEXT_TOKENS=50000
QA_MAX_RELEVANT_SEGMENTS=15

# GCP (optional, for Cloud Tasks)
GCP_PROJECT_ID=summarizerproxy
CLOUD_TASKS_QUEUE=processing-queue

# Stripe (Subscriptions)
STRIPE_SECRET_KEY=sk_live_xxx  # or sk_test_xxx for testing
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_WEEKLY=price_xxx   # Stripe Price ID for $4.89/week
STRIPE_PRICE_MONTHLY=price_xxx  # Stripe Price ID for $10.49/month
STRIPE_PRICE_YEARLY=price_xxx   # Stripe Price ID for $48.99/year
WEB_APP_URL=https://meetingmind.org
