# Backend-specific .gitignore

# Dependencies
node_modules/

# Build output
dist/

# Environment files (keep example)
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Test coverage
coverage/
.nyc_output/

# Temp files
tmp/
*.tmp
.fly-secrets.sh
